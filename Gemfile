source "https://rubygems.org"

# This version of the Agency theme works best with Jekyll 3.x or 4.x
gem "jekyll", "~> 3.9"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
end

# Support for GitHub Pages if you deploy there later
gem "github-pages", group: :jekyll_plugins